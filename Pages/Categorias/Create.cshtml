@page
@model RestauranteCategoriasPlatos.Pages.Categorias.CreateModel
@{
    ViewData["Title"] = "Registrar categoría";
}

<h1>Registrar categoría</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="Categoria.Nombre"></label><br />
        <input asp-for="Categoria.Nombre" />
        <span asp-validation-for="Categoria.Nombre" class="text-danger"></span>
    </div>
    <br />
    <div>
        <label asp-for="Categoria.Descripcion"></label><br />
        <input asp-for="Categoria.Descripcion" />
        <span asp-validation-for="Categoria.Descripcion" class="text-danger"></span>
    </div>
    <br />
    <button type="submit">Guardar</button>
    <a asp-page="Index">Cancelar</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
