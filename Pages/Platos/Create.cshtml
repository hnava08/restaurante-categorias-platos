@page
@model RestauranteCategoriasPlatos.Pages.Platos.CreateModel
@{
    ViewData["Title"] = "Registrar plato";
}

<h1>Registrar plato</h1>

@if (!Model.Categorias.Any())
{
    <p>Debe registrar al menos una categoría antes de crear un plato. <a asp-page="/Categorias/Create">Registrar categoría</a></p>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div>
            <label asp-for="Plato.Nombre"></label><br />
            <input asp-for="Plato.Nombre" />
            <span asp-validation-for="Plato.Nombre" class="text-danger"></span>
        </div>
        <br />
        <div>
            <label asp-for="Plato.Descripcion"></label><br />
            <input asp-for="Plato.Descripcion" />
            <span asp-validation-for="Plato.Descripcion" class="text-danger"></span>
        </div>
        <br />
        <div>
            <label asp-for="Plato.Precio"></label><br />
            <input asp-for="Plato.Precio" type="number" step="0.01" />
            <span asp-validation-for="Plato.Precio" class="text-danger"></span>
        </div>
        <br />
        <div>
            <label asp-for="Plato.Disponible"></label>
            <input asp-for="Plato.Disponible" />
        </div>
        <br />
        <div>
            <label asp-for="Plato.CategoriaId"></label><br />
            <select asp-for="Plato.CategoriaId" asp-items="Model.Categorias">
                <option value="">-- Seleccione una categoría --</option>
            </select>
            <span asp-validation-for="Plato.CategoriaId" class="text-danger"></span>
        </div>
        <br />
        <button type="submit">Guardar</button>
        <a asp-page="Index">Cancelar</a>
    </form>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
