@page
@model RestauranteCategoriasPlatos.Pages.Platos.IndexModel
@{
    ViewData["Title"] = "Platos";
}

<h1>Platos</h1>
<p><a asp-page="Create">Registrar plato</a></p>

@if (TempData["Mensaje"] is string mensaje)
{
    <p>@mensaje</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plato in Model.Platos)
        {
            <tr>
                <td>@plato.Nombre</td>
                <td>@plato.Categoria?.Nombre</td>
                <td>@plato.Precio.ToString("0.00")</td>
                <td>@(plato.Disponible ? "Sí" : "No")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@plato.Id">Editar</a>
                    |
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@plato.Id" style="display:inline">
                        <button type="submit" onclick="return confirm('¿Eliminar este plato?');">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
